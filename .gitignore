node_modules/

# Editor / agent tooling, and the shortcut that points AGENT.md at CLAUDE.md.
# Local to one machine, so it should not travel with the repo.
.claude/
AGENT.md.lnk

# Hand-made backups. The file's own history is in git, so these are only ever
# a local scratch copy.
*.bak

# Local build state: the per-mission metadata catalogs (and the legacy
# combined file they replaced). Regenerated by fetch_sar_data.py; the site
# only ships data/sar_status.js and data/sar_recent.json.
data/catalog_db.json
data/old_catalog_db.json
data/catalog/
# Retired: sar_status.js is now the single full-history file, wrapped so one
# file serves both file:// and the web. Ignored so a stale copy left over from
# an older checkout is never committed back.
data/sar_status.json
